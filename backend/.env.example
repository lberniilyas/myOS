# Copy this file to .env (same folder) and fill in your key.

# AI: "gemini" (default), "anthropic", or "none" (captures are saved but not processed).
AI_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite
# Used once when the main model is rate limited or overloaded.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Emails allowed to create an account, comma-separated. Locally sign-up is open when this is
# unset; on Vercel sign-up is closed to everyone not listed here.
# ALLOWED_EMAILS=you@example.com

# The project-local dev database (python scripts/devdb.py init).
DATABASE_URL=postgresql+psycopg://personal_os:personal_os@localhost:5433/personal_os
TEST_DATABASE_URL=postgresql+psycopg://personal_os:personal_os@localhost:5433/personal_os_test
